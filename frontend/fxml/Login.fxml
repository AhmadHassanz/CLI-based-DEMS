<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="login-root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="frontend.LoginController">
    <left>
        <VBox prefWidth="470" spacing="18" styleClass="brand-panel" BorderPane.alignment="CENTER">
            <Region prefHeight="60" />
            <Label text="⌾" style="-fx-font-size: 86; -fx-text-fill: white;" />
            <Label text="SEQE" styleClass="brand-title" />
            <Label text="Secure Evidence Query Engine" styleClass="brand-subtitle" />
            <Label text="A secure platform for managing, tracking and analyzing digital evidence with integrity and accountability." wrapText="true" style="-fx-font-size: 17; -fx-text-fill: white; -fx-line-spacing: 8;" />
            <Region VBox.vgrow="ALWAYS" />
            <Label text="© 2025 SEQE. All rights reserved." style="-fx-text-fill: #dbeafe;" />
        </VBox>
    </left>
    <center>
        <VBox alignment="CENTER" spacing="18">
            <VBox maxWidth="560" spacing="18" styleClass="login-card">
                <Label text="Welcome to SEQE" style="-fx-font-size: 28; -fx-font-weight: 800;" />
                <Label text="Authorized Personnel Access" style="-fx-font-size: 17; -fx-text-fill: #64748b;" />
                <TextField fx:id="usernameField" promptText="Username" styleClass="field" />
                <PasswordField fx:id="passwordField" promptText="Password" styleClass="field" />
                <ComboBox fx:id="roleCombo" promptText="Select Role" maxWidth="Infinity" styleClass="field" />
                <HBox spacing="16">
                    <Button text="Login" onAction="#handleLogin" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="primary-button" />
                    <Button text="Clear" onAction="#handleClear" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="ghost-button" />
                </HBox>
                <Label fx:id="messageLabel" styleClass="message" />
                <Label text="Activity is monitored and logged." styleClass="muted" />
            </VBox>
        </VBox>
    </center>
    <padding>
        <Insets top="14" right="14" bottom="14" left="14" />
    </padding>
</BorderPane>
